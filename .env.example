# Supabase public project URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Use only the Supabase anon public key in Vite.
# Never place the service_role key in frontend code or .env files used by Vite.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public bucket used by the admin panel to upload product images.
VITE_SUPABASE_STORAGE_BUCKET=product-images
